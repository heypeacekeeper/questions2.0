---
import ProseLayout from '@/layouts/ProseLayout.astro';
import { ROUTES } from '@/config/site';
import { PUBLISHER } from '@/config/publisher';
const meta = {
  title: 'Terms and Conditions',
  description:
    'Terms of use for Would You Rather Questions, including submissions and acceptable use.',
  path: ROUTES.terms,
};
---

<ProseLayout meta={meta} heading="Terms and Conditions" legal>
  <p>
    Operator:{' '}
    <span class:list={{ placeholder: !PUBLISHER.name }}>
      {PUBLISHER.name || 'Would You Rather Questions — legal entity to be added'}
    </span>
    . Governing law:{' '}
    <span class:list={{ placeholder: !PUBLISHER.jurisdiction }}>
      {PUBLISHER.jurisdiction || '[JURISDICTION]'}
    </span>
    .
  </p>
  <h2>Use of the site</h2>
  <p>
    The site is provided free for personal, educational and entertainment use. Do not scrape or
    overload it.
  </p>
  <h2>Submissions</h2>
  <p>
    By emailing us a question for publication, you confirm it is your own wording, grant us a
    perpetual, royalty-free licence to publish, edit and distribute it, and accept that it may be
    declined. See the <a href={ROUTES.editorialPolicy}>Editorial Policy</a>.
  </p>
  <h2>Content</h2>
  <p>
    Questions are for fun and are provided "as is" without warranties. Result percentages are
    deterministic display content and are not statistical measurements.
  </p>
  <h2>Copyright</h2>
  <p>
    Site design and text are © the operator. Report infringement via the{' '}
    <a href={ROUTES.dmca}>DMCA page</a>.
  </p>
</ProseLayout>
