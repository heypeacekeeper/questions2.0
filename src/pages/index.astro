---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Game from '@/components/Game.astro';
import QuestionList from '@/components/QuestionList.astro';
import AdSlot from '@/components/AdSlot.astro';
import { getContentContext } from '@/repositories/factory';
import { ROUTES } from '@/config/site';
import { initialGameQuestion } from '@/lib/page-data';
import type { Question } from '@/domain/question';

const ctx = await getContentContext();
const restrictedCategoryIds = new Set(
  (await ctx.categories.getAllCategories())
    .filter((category) => category.isMature || category.requiresAgeGate)
    .map((category) => category.id),
);
const visible = (await ctx.categoryService.getVisibleCategories()).filter(
  (category) => !category.isMature && !category.requiresAgeGate,
);
const packs = (await ctx.categoryService.getGamePackCategories()).map((c) => ({
  slug: c.slug,
  name: c.name,
  icon: c.icon,
  description: c.shortDescription,
  requiresAgeGate: c.requiresAgeGate || c.isMature,
}));
const initial = await initialGameQuestion(null);
const sections = (
  await Promise.all(
    visible.map(async (category) => ({
      category,
      questions: (await ctx.questionService.getHomepageSample(category)).filter(
        (question) => !question.categoryIds.some((id) => restrictedCategoryIds.has(id)),
      ),
    })),
  )
).filter((section) => section.questions.length > 0);
const featured: Question[] = [];
const featuredIds = new Set<string>();
for (let index = 0; index < 10 && featured.length < 10; index++) {
  for (const section of sections) {
    const question = section.questions[index];
    if (!question || featuredIds.has(question.id)) continue;
    featured.push(question);
    featuredIds.add(question.id);
    if (featured.length === 10) break;
  }
}
const tones = [
  ['#ffb3a3', '#ffe8e1'],
  ['#85dce3', '#e2f7f7'],
  ['#e3cd76', '#f8f2d9'],
  ['#afe0be', '#e7f6ea'],
  ['#d9b7ed', '#f5e9fb'],
  ['#bfc5f4', '#eceedf'],
  ['#ffceaa', '#fff0e2'],
] as const;
const toneStyle = (index: number) => {
  const [color, tint] = tones[index % tones.length] ?? tones[0];
  return `--section-color:${color};--section-tint:${tint}`;
};
const totalQuestions = (await ctx.questionService.getPublished()).length;
const meta = {
  title: 'Would You Rather Questions – Play Free Online',
  description:
    'Play free Would You Rather questions online, save your favorites, or browse the currently published collections for your next conversation.',
  path: ROUTES.home,
};
---

<BaseLayout meta={meta}>
  <section class="reference-hero" aria-labelledby="home-heading">
    <div class="wrap reference-hero-grid">
      <div class="reference-hero-copy">
        <h1 id="home-heading">
          Would You Rather <em>Questions</em>
        </h1>
        <p>
          Two options, one choice. Browse our published collections, read questions straight from
          the list, or play one dilemma at a time.
        </p>
        <div class="reference-hero-actions">
          <a class="reference-button reference-button-hot" href={ROUTES.play}>
            <span class="reference-action-long">Play the game →</span>
            <span class="reference-action-short">Play game →</span>
          </a>
          <a class="reference-button reference-button-ghost" href="#best">
            <span class="reference-action-long">Browse questions ↓</span>
            <span class="reference-action-short">Questions ↓</span>
          </a>
        </div>
      </div>
      {initial && (
        <a class="reference-game-preview" href={ROUTES.play} aria-label="Play Would You Rather">
          <span class="reference-preview-label">WOULD YOU RATHER…</span>
          <span class="reference-preview-choices">
            <span class="reference-preview-choice reference-preview-choice-a">
              <span class="reference-preview-option">OPTION A</span>
              <strong>{initial.a}</strong>
            </span>
            <span class="reference-preview-or" aria-hidden="true">
              OR
            </span>
            <span class="reference-preview-choice reference-preview-choice-b">
              <span class="reference-preview-option">OPTION B</span>
              <strong>{initial.b}</strong>
            </span>
          </span>
          <span class="reference-preview-play">Play the game →</span>
        </a>
      )}
    </div>
    <div class="wrap">
      <nav class="reference-category-strip" aria-label="Jump to a category">
        <span class="reference-mono">JUMP TO A CATEGORY</span>
        <div class="reference-strip-pills">
          {sections.map((section, index) => (
            <a href={`#${section.category.slug}`} style={toneStyle(index)}>
              <span class="reference-swatch" aria-hidden="true"></span>
              {section.category.name}
              {section.category.requiresAgeGate && <small>18+</small>}
            </a>
          ))}
        </div>
      </nav>
    </div>
  </section>

  <nav class="reference-sticky-jump" aria-label="Jump between question sections" inert>
    <div class="wrap reference-sticky-jump-inner">
      <a href="#best" data-jump-link="best" class="is-active">
        <span class="reference-swatch" aria-hidden="true"></span>Start here
      </a>
      {sections.map((section, index) => (
        <a
          href={`#${section.category.slug}`}
          data-jump-link={section.category.slug}
          style={toneStyle(index)}
        >
          <span class="reference-swatch" aria-hidden="true"></span>
          {section.category.name}
        </a>
      ))}
    </div>
  </nav>

  <div class="wrap reference-sections">
    {featured.length > 0 ? (
      <section class="reference-question-section" id="best" aria-labelledby="best-heading">
        <div class="reference-section-copy">
          <span class="reference-chip">● START HERE</span>
          <h2 id="best-heading">Would You Rather Questions to Try</h2>
          <p>A sample of our published questions. Pick one to start a conversation.</p>
          <p class="reference-question-count">
            {totalQuestions} questions to explore across the site
          </p>
        </div>
        <div class="reference-section-list">
          <QuestionList id="best-questions" questions={featured} />
        </div>
      </section>
    ) : (
      <section class="reference-question-section" id="best" aria-labelledby="best-heading">
        <div class="reference-section-copy">
          <h2 id="best-heading">Questions are coming soon</h2>
          <p>We're adding fresh Would You Rather questions. Check back soon to browse and play.</p>
        </div>
      </section>
    )}
    <AdSlot slot="inContent" class="reference-ad" />
    {sections.map((section, index) => (
      <>
        <section
          class="reference-question-section"
          id={section.category.slug}
          aria-labelledby={`${section.category.slug}-heading`}
          style={toneStyle(index)}
        >
          <div class="reference-section-copy">
            <span class="reference-chip">
              <span class="reference-swatch" aria-hidden="true"></span>
              {section.category.name}
            </span>
            <h2 id={`${section.category.slug}-heading`}>{section.category.h1}</h2>
            <p>{section.category.metaDescription}</p>
          </div>
          <div class="reference-section-list">
            <QuestionList id={`${section.category.slug}-questions`} questions={section.questions} />
            <a
              class="reference-button reference-button-category"
              href={section.category.canonicalPath}
            >
              See all {section.category.publishedQuestionCount}{' '}
              {section.category.name.toLowerCase()} questions →
            </a>
          </div>
        </section>
        {(index + 1) % 3 === 0 && <AdSlot slot="inContent" class="reference-ad" />}
      </>
    ))}
  </div>

  <section class="reference-how" aria-labelledby="how-to-heading">
    <div class="wrap">
      <span class="reference-mono">THE RULES ARE SIMPLE</span>
      <h2 id="how-to-heading">How to Play Would You Rather</h2>
      <div class="reference-how-steps">
        <article>
          <span>01</span>
          <h3>Read the choices</h3>
          <p>Every question gives you two options.</p>
        </article>
        <article>
          <span>02</span>
          <h3>Pick one</h3>
          <p>Choose option A or B. No “neither” allowed.</p>
        </article>
        <article>
          <span>03</span>
          <h3>Explain why</h3>
          <p>The best part is hearing everyone's reasoning.</p>
        </article>
      </div>
      <a class="reference-button reference-button-hot" href={ROUTES.play}>
        Play the game →
      </a>
    </div>
  </section>

  <section class="reference-home-game" aria-labelledby="home-game-heading">
    <div class="wrap">
      <span class="reference-chip">● PLAY NOW</span>
      <h2 id="home-game-heading">One question, two choices.</h2>
    </div>
    <Game mode="mixed" initial={initial} packs={packs} />
  </section>
  <AdSlot slot="belowGame" />
  <AdSlot slot="footer" />
</BaseLayout>

<script>
  import { initStickyJump } from '@/scripts/sticky-jump';
  initStickyJump();
</script>
