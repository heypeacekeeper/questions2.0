---
/** Generic category route + pagination: /<canonical-path>/ and /<canonical-path>/page/N/ */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Game from '@/components/Game.astro';
import QuestionList from '@/components/QuestionList.astro';
import Pagination from '@/components/Pagination.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Sidebar from '@/components/Sidebar.astro';
import RelatedCategories from '@/components/RelatedCategories.astro';
import AdSlot from '@/components/AdSlot.astro';
import { getContentContext } from '@/repositories/factory';
import { QuestionService } from '@/application/question-service';
import { PAGINATION, ROUTES, categoryPagePath } from '@/config/site';
import { collectionPageJsonLd, homeBreadcrumb } from '@/lib/seo';
import { initialGameQuestion, paragraphs, sidebarData } from '@/lib/page-data';
import type { CategoryWithCount } from '@/domain/category';

export async function getStaticPaths() {
  const ctx = await getContentContext();
  const visible = await ctx.categoryService.getVisibleCategories();
  const paths: {
    params: { category: string };
    props: { category: CategoryWithCount; page: number };
  }[] = [];
  for (const category of visible) {
    const pages = QuestionService.pageCount(category.publishedQuestionCount);
    const base = category.canonicalPath.replace(/^\/|\/$/g, '');
    for (let page = 1; page <= pages; page++) {
      paths.push({
        params: { category: page === 1 ? base : `${base}/${PAGINATION.pageSegment}/${page}` },
        props: { category, page },
      });
    }
  }
  return paths;
}

const { category, page } = Astro.props;
const ctx = await getContentContext();
const pagination = await ctx.questionService.getPage(category, page);
const related = await ctx.categoryService.getRelatedCategories(category);
const initial = await initialGameQuestion(category);
const { popular, seasonal } = await sidebarData(category.id);
const path = categoryPagePath(category.canonicalPath, page);
const pageSuffix = page > 1 ? ` – Page ${page}` : '';
const meta = {
  title: `${category.seoTitle}${pageSuffix}`,
  description:
    page > 1
      ? `${category.h1}, page ${page}: questions ${pagination.startIndex}–${pagination.endIndex} of ${pagination.totalItems}. ${category.metaDescription}`
      : category.metaDescription,
  path,
  prev: pagination.hasPrevious ? categoryPagePath(category.canonicalPath, page - 1) : undefined,
  next: pagination.hasNext ? categoryPagePath(category.canonicalPath, page + 1) : undefined,
};
const breadcrumbs = [
  homeBreadcrumb(),
  { name: 'Categories', path: ROUTES.categories },
  { name: category.name, path: category.canonicalPath },
  ...(page > 1 ? [{ name: `Page ${page}`, path }] : []),
];
---

<BaseLayout
  meta={meta}
  breadcrumbs={breadcrumbs}
  jsonLd={[collectionPageJsonLd(ctx.env.siteUrl, meta)]}
>
  <div class="wrap page-layout reference-category-layout">
    <div class="content-column reference-category-main">
      <header class="reference-category-hero">
        <Breadcrumbs items={breadcrumbs} />
        <h1>
          {category.h1}
          {page > 1 && <span class="sr-only"> – page {page}</span>}
        </h1>
        <div class="reference-category-description">
          {page === 1 ? (
            paragraphs(category.introduction).map((p) => <p>{p}</p>)
          ) : (
            <p>
              Page {page} of {category.name.toLowerCase()} questions ({pagination.startIndex}–
              {pagination.endIndex} of {pagination.totalItems}).{' '}
              <a href={category.canonicalPath}>Start from the beginning</a>.
            </p>
          )}
        </div>
      </header>
      <Game mode="category" initial={initial} setSlug={category.slug} category={category} />
      <section class="question-section reference-category-list" aria-labelledby="list-heading">
        <header class="section-header">
          <h2 id="list-heading">
            {page > 1
              ? `Questions ${pagination.startIndex}–${pagination.endIndex}`
              : `All ${category.name} Would You Rather Questions`}
          </h2>
          <span class="reference-mono">{pagination.totalItems} QUESTIONS</span>
        </header>
        <QuestionList
          id="category-questions"
          questions={pagination.items}
          startIndex={pagination.startIndex}
          long={pagination.items.length > 20}
          ariaLabel={`${category.name} questions`}
        />
        <Pagination pagination={pagination} basePath={category.canonicalPath} />
      </section>
      <AdSlot slot="belowGame" />
      <AdSlot slot="inContent" class="inline-ad" />
      <RelatedCategories categories={related} />
    </div>
    <Sidebar popular={popular} seasonal={seasonal} />
  </div>
</BaseLayout>
