---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogCard from '@/components/BlogCard.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { ROUTES } from '@/config/site';
import { getPublishedBlogPosts } from '@/lib/blog';
import { homeBreadcrumb } from '@/lib/seo';

const posts = await getPublishedBlogPosts();
const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const remainingPosts = featuredPost ? posts.filter((post) => post.id !== featuredPost.id) : [];

const meta = {
  title: 'Blog – Would You Rather Questions',
  description:
    'Helpful guides, game ideas, conversation tips and creative ways to play Would You Rather with friends, families, couples, classrooms and groups.',
  path: ROUTES.blog,
  robots: posts.length > 0 ? 'index,follow,max-image-preview:large' : 'noindex,follow',
};

const breadcrumbs = [
  homeBreadcrumb(),
  {
    name: 'Blog',
    path: ROUTES.blog,
  },
];
---

<BaseLayout meta={meta} breadcrumbs={breadcrumbs} bodyClass="blog-index">
  <section class="blog-hero">
    <div class="wrap">
      <Breadcrumbs items={breadcrumbs} />

      <div class="blog-hero-copy">
        <p class="blog-eyebrow">Ideas, guides and conversation starters</p>
        <h1>The Would You Rather Blog</h1>
        <p>
          Practical ways to play, better questions to ask, and simple ideas for making parties,
          classrooms, dates and family time more memorable.
        </p>
      </div>
    </div>
  </section>

  <div class="wrap blog-content">
    {featuredPost ? (
      <>
        <section class="blog-featured" aria-labelledby="featured-article-heading">
          <h2 class="sr-only" id="featured-article-heading">
            Featured article
          </h2>
          <BlogCard post={featuredPost} featured />
        </section>

        {remainingPosts.length > 0 && (
          <section class="blog-latest" aria-labelledby="latest-articles-heading">
            <header class="blog-section-header">
              <div>
                <span class="section-tag">Latest articles</span>
                <h2 id="latest-articles-heading">More from the blog</h2>
              </div>
              <p>
                Helpful ideas for groups, families, classrooms, couples and anyone looking for a
                better conversation.
              </p>
            </header>

            <div class="blog-grid">
              {remainingPosts.map((post) => (
                <BlogCard post={post} />
              ))}
            </div>
          </section>
        )}
      </>
    ) : (
      <section class="blog-empty" aria-labelledby="blog-empty-heading">
        <span class="blog-empty-icon" aria-hidden="true">
          ?
        </span>
        <h2 id="blog-empty-heading">Articles are coming soon</h2>
        <p>
          We’re preparing practical Would You Rather guides, party ideas and conversation tips.
          Until then, explore the question categories or play the interactive game.
        </p>
        <div class="blog-empty-actions">
          <a class="blog-primary-link" href={ROUTES.categories}>
            Browse questions
          </a>
          <a class="blog-secondary-link" href={ROUTES.home}>
            Play the game
          </a>
        </div>
      </section>
    )}

    <aside class="blog-cta" aria-labelledby="blog-cta-heading">
      <div>
        <span class="section-tag">Ready to choose?</span>
        <h2 id="blog-cta-heading">Put the ideas into practice</h2>
        <p>Browse questions by category or start playing immediately—no account required.</p>
      </div>

      <div class="blog-cta-actions">
        <a class="blog-primary-link" href={ROUTES.categories}>
          Explore categories
        </a>
        <a class="blog-secondary-link" href={ROUTES.home}>
          Play now
        </a>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .blog-hero {
    padding: clamp(34px, 6vw, 72px) 0 clamp(30px, 5vw, 56px);
    background:
      radial-gradient(circle at 82% 20%, rgba(255, 212, 42, 0.2), transparent 27%),
      radial-gradient(circle at 14% 74%, rgba(245, 46, 114, 0.1), transparent 30%);
    border-bottom: 1px solid var(--line);
  }

  .blog-hero-copy {
    max-width: 850px;
    margin-top: 22px;
  }

  .blog-eyebrow {
    margin: 0 0 8px;
    color: var(--pink-dark);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .blog-hero h1 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(40px, 7vw, 68px);
    line-height: 1.03;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .blog-hero-copy > p:last-child {
    max-width: 760px;
    margin: 17px 0 0;
    color: var(--text);
    font-size: clamp(17px, 2vw, 20px);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .blog-content {
    padding-block: clamp(32px, 6vw, 72px);
  }

  .blog-featured {
    margin-bottom: clamp(48px, 7vw, 84px);
  }

  .blog-latest {
    margin-bottom: clamp(52px, 7vw, 82px);
  }

  .blog-section-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.7fr);
    align-items: end;
    gap: 30px;
    margin-bottom: 24px;
  }

  .blog-section-header h2 {
    margin: 2px 0 0;
    font-size: clamp(30px, 4vw, 43px);
    line-height: 1.12;
    letter-spacing: -0.04em;
  }

  .blog-section-header p {
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 21px;
  }

  .blog-empty {
    max-width: 760px;
    margin: 0 auto clamp(52px, 8vw, 90px);
    padding: clamp(30px, 6vw, 58px);
    text-align: center;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 22px;
    box-shadow: var(--shadow-md);
  }

  .blog-empty-icon {
    width: 70px;
    height: 70px;
    display: grid;
    place-items: center;
    margin: 0 auto 17px;
    color: #fff;
    background: linear-gradient(135deg, var(--pink), var(--purple));
    border-radius: 50%;
    font-size: 38px;
    font-weight: 900;
    transform: rotate(-6deg);
  }

  .blog-empty h2 {
    margin: 0;
    font-size: clamp(28px, 4vw, 39px);
    line-height: 1.15;
  }

  .blog-empty p {
    max-width: 590px;
    margin: 13px auto 0;
    color: var(--text);
    line-height: 1.7;
  }

  .blog-empty-actions,
  .blog-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .blog-empty-actions {
    justify-content: center;
    margin-top: 22px;
  }

  .blog-primary-link,
  .blog-secondary-link {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 11px 17px;
    border: 2px solid transparent;
    border-radius: 11px;
    font-weight: 900;
  }

  .blog-primary-link {
    color: #fff;
    background: var(--pink-dark);
  }

  .blog-primary-link:hover {
    color: #fff;
    background: #b90f49;
    text-decoration: none;
  }

  .blog-secondary-link {
    color: var(--ink);
    background: #fff;
    border-color: var(--line);
  }

  .blog-secondary-link:hover {
    border-color: var(--purple);
    background: #faf7ff;
    text-decoration: none;
  }

  .blog-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    padding: clamp(25px, 5vw, 42px);
    color: var(--ink);
    background: radial-gradient(circle at 85% 10%, rgba(255, 212, 42, 0.45), transparent 26%), #fff;
    border: 1px solid var(--line);
    border-radius: 22px;
    box-shadow: var(--shadow-sm);
  }

  .blog-cta > div:first-child {
    max-width: 700px;
  }

  .blog-cta h2 {
    margin: 3px 0 0;
    font-size: clamp(27px, 4vw, 39px);
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .blog-cta p {
    margin: 9px 0 0;
    color: var(--text);
  }

  .blog-cta-actions {
    flex: 0 0 auto;
  }

  @media (max-width: 900px) {
    .blog-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .blog-section-header {
      display: block;
    }

    .blog-section-header p {
      margin-top: 10px;
    }

    .blog-grid {
      grid-template-columns: 1fr;
    }

    .blog-cta {
      display: block;
    }

    .blog-cta-actions {
      margin-top: 20px;
    }
  }

  @media (max-width: 460px) {
    .blog-empty-actions,
    .blog-cta-actions {
      flex-direction: column;
    }
  }
</style>
