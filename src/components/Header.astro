---
/**
 * Site header: text logo, Categories dropdown (data-driven), About, Contact,
 * Submit CTA, mobile hamburger + scrim. Behaviour in public/navigation.js.
 */
import type { CategoryWithCount } from '@/domain/category';
import { BRAND_NAME, ROUTES } from '@/config/site';

interface Props {
  categories: readonly CategoryWithCount[];
}
const { categories } = Astro.props;
---

<header class="site-nav" id="site-header">
  <div class="wrap nav-inner">
    <a data-astro-prefetch class="brand" href={ROUTES.home} aria-label={`${BRAND_NAME} home`}>
      <span>
        Would You Rather <strong>Questions</strong>
      </span>
    </a>

    <button
      class="menu-button"
      id="menu-button"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="nav-links"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="nav-links" id="nav-links" aria-label="Main navigation">
      <div class="category-dropdown">
        <button
          class="category-button"
          id="category-button"
          type="button"
          aria-expanded="false"
          aria-controls="category-menu"
          aria-haspopup="true"
        >
          <span>Categories</span>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="4"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="m5 8 7 8 7-8" />
          </svg>
        </button>

        <div class="category-menu" id="category-menu" hidden>
          {categories.map((c) => (
            <a data-astro-prefetch href={c.canonicalPath}>
              <span class="category-icon" aria-hidden="true">
                {c.icon}
              </span>
              <span class="category-copy">
                <strong>{c.name}</strong>
                <small>{c.shortDescription}</small>
              </span>
            </a>
          ))}
          <a data-astro-prefetch class="view-all" href={ROUTES.categories}>
            View all categories →
          </a>
        </div>
      </div>

      <a data-astro-prefetch class="nav-link" href={ROUTES.favorites}>
        Favorites
      </a>

      <a data-astro-prefetch class="nav-link reference-extra-nav" href={ROUTES.blog}>
        Blog
      </a>

      <a data-astro-prefetch class="nav-link" href={ROUTES.about}>
        About Us
      </a>
      <a data-astro-prefetch class="nav-link" href={ROUTES.contact}>
        Contact Us
      </a>
      <a data-astro-prefetch class="submit-link reference-submit-nav" href={ROUTES.submit}>
        ＋ Submit a Question
      </a>
      <a data-astro-prefetch class="reference-nav-play" href={ROUTES.play}>
        Play Game →
      </a>
    </nav>
  </div>
</header>

<div class="nav-scrim" id="nav-scrim"></div>

<script src="../scripts/navigation.js"></script>
