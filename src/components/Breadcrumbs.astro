---
import type { BreadcrumbItem } from '@/lib/seo';
interface Props {
  items: readonly BreadcrumbItem[];
}
const { items } = Astro.props;
---

{items.length > 1 && (
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol>
      {items.map((item, i) => (
        <li>
          {i === items.length - 1 ? (
            <span aria-current="page">{item.name}</span>
          ) : (
            <a href={item.path}>{item.name}</a>
          )}
        </li>
      ))}
    </ol>
  </nav>
)}
