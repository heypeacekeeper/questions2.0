---
/**
 * Static numbered question list with a copy control. Numbering continues
 * across pagination via `startIndex`.
 */
import type { Question } from '@/domain/question';

interface Props {
  questions: readonly Question[];
  /** 1-based number of the first row (default 1). */
  startIndex?: number;
  /** Apply rendering containment (below-the-fold long lists only). */
  long?: boolean;
  /** Unique page-local id, also used to associate copy buttons with their question text. */
  id: string;
  ariaLabel?: string;
}
const { questions, startIndex = 1, long = false, id, ariaLabel } = Astro.props;
---

<ol
  class:list={['question-list', { 'long-list': long }]}
  id={id}
  aria-label={ariaLabel}
  style={startIndex > 1 ? `--list-start:${startIndex - 1}` : undefined}
  start={startIndex}
>
  {questions.map((q, index) => (
    <li class="question-row">
      <span class="question-number" aria-hidden="true"></span>
      <p id={`${id}-question-${startIndex + index}`}>
        <span class="question-prefix">Would you rather </span>
        <strong>{q.optionA}</strong> or <strong>{q.optionB}</strong>?
      </p>
      <button
        class="question-copy"
        type="button"
        aria-label="Copy this question"
        aria-describedby={`${id}-question-${startIndex + index}`}
        title="Copy question"
      ></button>
    </li>
  ))}
</ol>

<script>
  import { initQuestionCopy } from '@/scripts/question-copy';
  initQuestionCopy();
</script>
