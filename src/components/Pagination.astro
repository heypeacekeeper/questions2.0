---
/** Crawlable pagination with real <a data-astro-prefetch href> links and rel prev/next. */
import type { PaginationResult } from '@/domain/site';
import { categoryPagePath } from '@/config/site';

interface Props {
  pagination: PaginationResult<unknown>;
  basePath: string;
  label?: string;
}
const { pagination: p, basePath, label = 'Question list pages' } = Astro.props;

function pageNumbers(current: number, total: number): (number | 'gap')[] {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
  const set = new Set<number>(
    [1, total, current - 1, current, current + 1].filter((n) => n >= 1 && n <= total),
  );
  const sorted = [...set].sort((a, b) => a - b);
  const out: (number | 'gap')[] = [];
  for (let i = 0; i < sorted.length; i++) {
    const n = sorted[i] as number;
    const prev = sorted[i - 1];
    if (prev !== undefined && n - prev > 1) out.push('gap');
    out.push(n);
  }
  return out;
}
---

{p.totalPages > 1 && (
  <nav class="pagination-nav" aria-label={label}>
    <p class="pagination-summary">
      Showing questions {p.startIndex}–{p.endIndex} of {p.totalItems}
    </p>
    <div class="pagination">
      {p.hasPrevious ? (
        <a data-astro-prefetch href={categoryPagePath(basePath, p.page - 1)} rel="prev">
          ← Previous
        </a>
      ) : (
        <span aria-disabled="true">← Previous</span>
      )}
      {pageNumbers(p.page, p.totalPages).map((n) =>
        n === 'gap' ? (
          <span class="ellipsis" aria-hidden="true">
            …
          </span>
        ) : n === p.page ? (
          <span aria-current="page">{n}</span>
        ) : (
          <a data-astro-prefetch href={categoryPagePath(basePath, n)} aria-label={`Page ${n}`}>
            {n}
          </a>
        ),
      )}
      {p.hasNext ? (
        <a data-astro-prefetch href={categoryPagePath(basePath, p.page + 1)} rel="next">
          Next →
        </a>
      ) : (
        <span aria-disabled="true">Next →</span>
      )}
    </div>
  </nav>
)}
