---
/**
 * Base document: metadata, structured data, header, footer, consent manager,
 * analytics (consent-gated), and the shared stylesheet.
 */
import '@/styles/global.css';
import '@/styles/handoff.css';
import Header from '@/components/Header.astro';
import PageLoadingIndicator from '@/components/PageLoadingIndicator.astro';
import Footer from '@/components/Footer.astro';
import ConsentManager from '@/components/ConsentManager.astro';
import Analytics from '@/components/Analytics.astro';
import { getContentContext } from '@/repositories/factory';
import { BRAND_NAME, PUBLIC_EMAIL, SOCIAL, absoluteUrl } from '@/config/site';
import {
  breadcrumbJsonLd,
  defaultImage,
  jsonLdString,
  organizationJsonLd,
  websiteJsonLd,
  type BreadcrumbItem,
  type PageMeta,
} from '@/lib/seo';

interface Props {
  meta: PageMeta;
  breadcrumbs?: readonly BreadcrumbItem[];
  /** Additional JSON-LD blocks. */
  jsonLd?: readonly Record<string, unknown>[];
  /** Body class hook. */
  bodyClass?: string;
}

const { meta, breadcrumbs = [], jsonLd = [], bodyClass } = Astro.props;
const ctx = await getContentContext();
const { env } = ctx;
const siteUrl = env.siteUrl;
const previewSystemFonts = env.allowDemoContent;

const canonical = absoluteUrl(meta.path, siteUrl);
const ogImage = meta.image
  ? meta.image.startsWith('http')
    ? meta.image
    : absoluteUrl(meta.image, siteUrl)
  : defaultImage(siteUrl);
const robots = meta.robots ?? 'index,follow,max-image-preview:large';
// Titles from the CMS are authored complete; only bare titles get the brand suffix.
const title = meta.title.includes(BRAND_NAME) ? meta.title : `${meta.title} – ${BRAND_NAME}`;

const navCategories = await ctx.categoryService.getNavigationCategories();

const structuredData: Record<string, unknown>[] = [
  websiteJsonLd(
    siteUrl,
    'Free Would You Rather questions for kids, teens, adults, couples, friends, family, work and classrooms.',
  ),
  organizationJsonLd(siteUrl, PUBLIC_EMAIL),
  ...(breadcrumbs.length > 1 ? [breadcrumbJsonLd(siteUrl, breadcrumbs)] : []),
  ...jsonLd,
];
---

<!doctype html>
<html lang="en" data-font-preview={previewSystemFonts ? 'system' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#f6f2eb" />

    <title>{title}</title>
    <meta name="description" content={meta.description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {meta.prev && <link rel="prev" href={absoluteUrl(meta.prev, siteUrl)} />}
    {meta.next && <link rel="next" href={absoluteUrl(meta.next, siteUrl)} />}
    {env.searchConsoleVerification && (
      <meta name="google-site-verification" content={env.searchConsoleVerification} />
    )}

    <meta property="og:type" content={meta.ogType ?? 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={BRAND_NAME} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(SOCIAL.imageWidth)} />
    <meta property="og:image:height" content={String(SOCIAL.imageHeight)} />
    <meta property="og:image:alt" content={meta.imageAlt ?? BRAND_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content={SOCIAL.twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {structuredData.map((block) => (
      <script is:inline type="application/ld+json" set:html={jsonLdString(block)}></script>
    ))}
    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <PageLoadingIndicator />
    {previewSystemFonts && (
      <details class="font-preview-panel">
        <summary>Font preview · local</summary>
        <label for="system-font-toggle">
          <input id="system-font-toggle" type="checkbox" checked />
          Use system font
        </label>
      </details>
    )}
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>

    <Header categories={navCategories} />

    <main id="main-content">
      <slot />
    </main>

    <Footer showConsentPreferences={env.features.FEATURE_GA4 || env.features.FEATURE_ADS} />

    <ConsentManager />
    <Analytics />
  </body>
</html>
