# ============================================================================
# Would You Rather Questions — environment variables
# Copy to `.env` for local builds. NEVER commit `.env`.
# Cloudflare: non-secret values go in wrangler.jsonc `vars`.
# Variables prefixed PUBLIC_ may be embedded in HTML/JS. Nothing else may.
# ============================================================================

# --- Site -------------------------------------------------------------------
PUBLIC_SITE_URL=https://wouldyouratherquestions.org

# --- Local demo content ----------------------------------------------------
# Production builds refuse published demo questions unless explicitly opted in.
# Set true only for local previews and tests; never for deployment.
ALLOW_DEMO_CONTENT=false

# --- Analytics --------------------------------------------------------------
FEATURE_GA4=false
PUBLIC_GA4_MEASUREMENT_ID=
FEATURE_CLOUDFLARE_ANALYTICS=false
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
# Google Search Console HTML-tag verification content value
PUBLIC_SEARCH_CONSOLE_VERIFICATION=

# --- Advertising (disabled until AdSense approval) --------------------------
FEATURE_ADS=false
PUBLIC_ADSENSE_PUBLISHER_ID=
